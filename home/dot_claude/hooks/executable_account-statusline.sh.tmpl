#!/usr/bin/env bash
# StatusLine: show active Claude account, highlighted red when it mismatches the cwd policy.
set -u

WORK_EMAIL="{{ .workEmail }}"
PERSONAL_DIR="$HOME/src/personal"

input="$(cat 2>/dev/null || true)"
cwd="$(printf '%s' "$input" | /usr/bin/python3 -c 'import json,sys,os
try:
  d=json.loads(sys.stdin.read() or "{}")
  print(d.get("cwd") or d.get("workspace",{}).get("current_dir") or os.environ.get("PWD",""))
except Exception:
  print(os.environ.get("PWD",""))' 2>/dev/null)"
cwd="${cwd:-$PWD}"
cwd_abs="$(cd "$cwd" 2>/dev/null && pwd -P || printf '%s' "$cwd")"
personal_abs="$(cd "$PERSONAL_DIR" 2>/dev/null && pwd -P || printf '%s' "$PERSONAL_DIR")"

active_email="$(/usr/bin/python3 -c 'import json
try: print(json.load(open("{{ .chezmoi.homeDir }}/.claude.json")).get("oauthAccount",{}).get("emailAddress",""))
except Exception: print("")' 2>/dev/null)"
active_email="${active_email:-not-logged-in}"

case "$cwd_abs/" in
  "$personal_abs"/*) in_personal=1 ;;
  *)                 in_personal=0 ;;
esac

mismatch=0
if [ "$in_personal" = "1" ] && [ "$active_email" = "$WORK_EMAIL" ]; then mismatch=1; fi
if [ "$in_personal" = "0" ] && [ "$active_email" != "$WORK_EMAIL" ] && [ "$active_email" != "not-logged-in" ]; then mismatch=1; fi

RED=$'\033[1;31m'
GREEN=$'\033[32m'
DIM=$'\033[2m'
RESET=$'\033[0m'

if [ "$mismatch" = "1" ]; then
  printf '%s⚠ ACCOUNT MISMATCH: %s in %s — /login to switch%s' "$RED" "$active_email" "$cwd_abs" "$RESET"
else
  label="work"; [ "$in_personal" = "1" ] && label="personal"
  printf '%s%s%s %s(%s)%s' "$GREEN" "$active_email" "$RESET" "$DIM" "$label" "$RESET"
fi
