# Headless standup-draft Slack delivery — config template.
#
# Copy to ~/.config/standup/slack-dm.env and chmod 600. NEVER commit the real file
# (it holds a token). Only deliver-to-slack-dm.sh reads it; the model never sees it.
#
#   mkdir -p ~/.config/standup
#   cp slack-dm.env.example ~/.config/standup/slack-dm.env
#   chmod 600 ~/.config/standup/slack-dm.env
#   $EDITOR ~/.config/standup/slack-dm.env   # fill in the two values below
#
# SLACK_TOKEN — a Slack token that can post a DM. Two options:
#   * Bot token (xoxb-…): create an app at https://api.slack.com/apps in this
#     workspace, add bot scopes `chat:write` + `im:write`, install, copy the token.
#     The draft arrives as a DM from that app.
#   * User token (xoxp-…): user scope `chat:write`. The draft arrives as a
#     message-to-self. Pick whichever your workspace admin allows.
SLACK_TOKEN=xoxb-REPLACE-ME

# SLACK_DM_USER_ID — the Slack member id whose DM to post into (i.e. your own).
# Find it via the interactive Slack connector (slack_search_users reports the
# logged-in user's id) or Slack profile → "Copy member ID".
SLACK_DM_USER_ID=U09PRSV657S
