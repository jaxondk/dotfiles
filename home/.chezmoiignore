{{/* .chezmoiignore is itself templated. Patterns are TARGET paths relative to $HOME. */}}

# opencode plugin deps are installed by `bun install` (run_once script), not chezmoi.
# bun.lock is regenerated by bun on every install, so let bun own it (package.json
# is the managed source of truth).
.config/opencode/node_modules
.config/opencode/bun.lock
.config/opencode/kdco-notify.json
.config/opencode/.bd-enabled

# The personal git identity is only deployed when a personal email was given at init.
{{ if not .personalGitEmail }}
.gitconfig-personal
{{ end }}

# Work-only Claude skills/commands are symlinks into the Twenty-IO/shadow-factory repo.
# Skip them unless that repo is actually cloned, so a fresh or personal box never
# gets dangling symlinks.
{{ if not (stat (joinPath .chezmoi.homeDir "src/xx-internal-ai/shadow-factory")) }}
.claude/skills/shadow-*
.claude/commands/mission.md
.claude/commands/mission-*.md

# The account guard/statusline enforce "work account everywhere except ~/src/personal".
# That policy only makes sense on the work box; on a personal machine it would block
# every prompt and pin the statusline to a permanent mismatch warning. The
# modify_settings.json script omits the matching hook + statusLine entries under the
# same condition.
.claude/hooks/account-guard.sh
.claude/hooks/account-statusline.sh
{{ end }}

# Runtime state written by the tools themselves, never by us. Tracking these makes
# every machine clobber every other one with a stale snapshot — and chezmoi ends up
# fighting a running process for the file. Claude Code rewrites the plugin manifests
# whenever a plugin is added or removed; the skill lock is rewritten on skill install.
# (main's commit 24d2291, "gitignore claude code runtime state", reached the same
# conclusion before the chezmoi migration re-adopted them.)
.claude/plugins/installed_plugins.json
.claude/plugins/known_marketplaces.json
.agents/.skill-lock.json

# Generated by `herdr integration install claude` (run_once_after_40), which also adds
# the matching hook entries to settings.json. The script carries a HERDR_INTEGRATION_VERSION
# that herdr bumps; committing it would pin every machine to one version forever.
.claude/hooks/herdr-agent-state.sh

# Same reasoning, same script (run_once_after_40): the herdr agent skill is herdr's own
# output, emitted by `herdr --skill`. The vendored copy had already gone two minor
# versions stale — it still taught the pre-0.7.5 `herdr wait`, which 0.7.5 renamed to
# `pane wait-output`/`agent wait` — which is exactly the pinning this avoids. Each
# machine now gets the skill that its own herdr binary ships.
.claude/skills/herdr/SKILL.md

# cliamp writes several files next to its config.toml. Only config.toml is tracked
# (theme + Spotify client_id + bitrate); everything else is per-machine, tool-owned,
# or sensitive and must never reach this public repo. spotify_credentials.json holds
# an OAuth refresh_token in particular. These entries guard against a future
# `chezmoi add -r ~/.config/cliamp` accidentally slurping them in.
.config/cliamp/spotify_credentials.json
.config/cliamp/history.toml
.config/cliamp/resume.json
.config/cliamp/cliamp.log
.config/cliamp/cliamp.sock
.config/cliamp/cliamp.sock.pid
