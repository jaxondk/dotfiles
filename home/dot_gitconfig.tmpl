# This is Git's per-user configuration file.
[user]
	name = {{ .name }}
	email = {{ .email }}
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[init]
	defaultBranch = main

[rerere]
	enabled = true
{{- if .personalGitEmail }}

# Personal repos under ~/src/personal/ use a different identity.
# This block is only written when a personal git email was provided at init.
[includeIf "gitdir:~/src/personal/"]
	path = ~/.gitconfig-personal
{{- end }}
{{- if eq .chezmoi.os "linux" }}

# Linux boxes (devbox) auth to GitHub over https via gh. Owned here so
# `gh auth setup-git` doesn't write unmanaged lines that block chezmoi apply.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
{{- end }}
