# macOS
.DS_Store

# Editor
*.swp
*.swo
*~

# Claude Code: ~/.claude is symlinked into this tree, so runtime state
# (credentials, sessions, history, caches) lands here. Ignore everything
# by default, then opt in to the config dirs we actually want to track.
claude-code/.claude/*
!claude-code/.claude/agents/
!claude-code/.claude/skills/
!claude-code/.claude/commands/
!claude-code/.claude/plugins/
!claude-code/.claude/scripts/
!claude-code/.claude/hooks/
!claude-code/.claude/mcp.json
!claude-code/.claude/settings.json

# Machine-local secrets / overrides (never track)
.zshrc.local
